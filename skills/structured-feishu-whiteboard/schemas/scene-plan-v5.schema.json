{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Feishu Whiteboard V5 Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engine", "scene", "style", "title", "summary", "summarySourceFactIds", "confidence", "nodes", "edges", "sourceFactIds"],
  "properties": {
    "schemaVersion": { "const": "5.0-alpha.2" },
    "engine": { "const": "v5" },
    "scene": { "enum": ["layered-architecture", "swimlane-process", "flywheel-loop", "decision-comparison", "evidence-argument", "operating-dashboard"] },
    "style": { "enum": ["linear-system", "professional-blue", "apple-report", "stripe-data", "vercel-precision", "feishu-status"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 180 },
    "summarySourceFactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "margin", "reasons"],
      "properties": {
        "level": { "enum": ["high", "medium", "low"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "margin": { "type": "number", "minimum": 0, "maximum": 100 },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "centerTitle": { "type": "string", "maxLength": 36 },
    "recommendation": { "type": "string", "maxLength": 120 },
    "recommendationSourceFactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "optionNodeIds": { "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "criterionNodeIds": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "thesisNodeId": { "type": "string" },
    "evidenceNodeIds": { "type": "array", "minItems": 3, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "metricNodeIds": { "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "supportNodeIds": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 20 },
          "sourceFactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "nodeIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 24 },
          "nodeIds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
          "sourceFactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourceFactIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 48 },
          "note": { "type": "string", "maxLength": 100 },
          "laneId": { "type": "string" },
          "layerId": { "type": "string" },
          "order": { "type": "number" },
          "kind": { "enum": ["entity", "action", "decision", "result", "stage", "option", "criterion", "thesis", "evidence", "metric", "trend", "risk"] },
          "status": { "enum": ["neutral", "good", "risk"] },
          "value": { "type": "string", "maxLength": 30 },
          "numericValue": { "type": "number" },
          "unit": { "type": "string", "maxLength": 12 },
          "sourceFactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["precedes", "supports", "depends-on", "produces", "belongs-to", "owned-by"] },
          "label": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "sourceFactIds": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } }
  }
}
