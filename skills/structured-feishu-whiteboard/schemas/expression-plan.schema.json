{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Feishu Whiteboard V4.4 Expression Plan",
  "type": "object",
  "required": ["planId", "scenario", "narrativeType", "pageSkeleton", "layout", "regions", "componentMix", "scoreBreakdown"],
  "properties": {
    "planId": { "type": "string" },
    "scenario": { "type": "string" },
    "narrativeType": { "enum": ["result-driven", "problem-driven", "comparison-driven", "causal", "temporal", "hierarchical", "flow-driven"] },
    "pageSkeleton": { "enum": ["overview-detail", "past-future-split", "left-right-argument", "multi-line-comparison", "centered-system", "timeline", "swimlane"] },
    "layout": { "enum": ["expression-canvas", "flow-canvas"] },
    "regions": { "type": "array", "minItems": 1 },
    "componentMix": { "type": "array", "minItems": 1, "uniqueItems": true },
    "scoreBreakdown": { "type": "object", "required": ["total"] }
  }
}
